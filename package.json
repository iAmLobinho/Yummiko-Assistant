{
  "name": "yummiko",
  "version": "1.0.0",
  "description": "Assistente pessoal Yummiko",
  "author": "Lobo",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.seunome.yummiko",
    "productName": "Yummiko",
    "files": [
      "electron.js",
      "preload.js",
      "database.js",
      "frontend/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0"
  }
}